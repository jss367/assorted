@dataclass
class Provider:
    name: str
    env_vars: tuple[str, ...]
    # Patterns are tried in order; first match wins. Used to classify a bare
    # value (no env-var context).
    value_patterns: tuple[re.Pattern, ...]
    probe: Callable[[str], dict] | None = None
    # Keychain service names worth querying on macOS.
    keychain_services: tuple[str, ...] = ()
    # Per-provider config files to scan if present.
    config_paths: tuple[Path, ...] = ()


# ---------------------------------------------------------------------------
# Probes — each returns a small dict of facts about the key, or raises.
# Network errors / non-2xx are caught upstream and reported as "probe failed".
# ---------------------------------------------------------------------------


def _http_get(url: str, headers: dict[str, str]) -> tuple[int, bytes]:
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            return resp.status, resp.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read() if e.fp else b""


def _http_json(url: str, headers: dict[str, str]) -> tuple[int, dict | list | None]:
    status, body = _http_get(url, headers)
    if not body:
        return status, None
    try:
        return status, json.loads(body.decode("utf-8", errors="replace"))
    except (ValueError, UnicodeDecodeError):
        return status, None


def probe_anthropic(key: str) -> dict:
    status, data = _http_json(
        "https://api.anthropic.com/v1/models",
        {"x-api-key": key, "anthropic-version": "2023-06-01"},
    )
    if status == 200 and isinstance(data, dict):
        models = data.get("data", [])
        return {"ok": True, "models": len(models)}
    return {"ok": False, "status": status, "detail": _err(data)}


