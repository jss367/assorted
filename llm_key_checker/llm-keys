#!/usr/bin/env python3
"""llm-keys — scan this machine for LLM provider API keys and report what's here.

Looks for keys in env vars, shell rc files, .env/.envrc files, provider config
files, and (on macOS) the Keychain. For each key it finds, optionally probes a
free metadata endpoint to confirm the key works and learn about the account
behind it.
"""
