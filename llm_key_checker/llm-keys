    return {"ok": False, "status": status, "detail": _err(data)}


def _err(data) -> str:
    if isinstance(data, dict):
        # Try a few common error-message shapes.
        for k in ("error", "message", "detail"):
            v = data.get(k)
            if isinstance(v, str):
                return v[:200]
            if isinstance(v, dict) and isinstance(v.get("message"), str):
                return v["message"][:200]
    return ""


def _err_bytes(b: bytes) -> str:
    try:
        return _err(json.loads(b.decode("utf-8", errors="replace")))
    except ValueError:
        return b[:200].decode("utf-8", errors="replace")


