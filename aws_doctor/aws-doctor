#!/usr/bin/env bash
# aws-doctor — diagnose what's going on with your AWS setup.
# Reports env vars, config files, profile resolution, conflicts, and identity check.

set +u  # macOS bash 3.2 dislikes empty-array expansion under set -u

# ---------- colors ----------
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'; C_CYAN=$'\033[36m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN=""
fi

WARNINGS=()
ERRORS=()
INFO=()

warn()  { WARNINGS+=("$1"); }
err()   { ERRORS+=("$1"); }
info()  { INFO+=("$1"); }

section() { printf "\n${C_BOLD}${C_BLUE}== %s ==${C_RESET}\n" "$1"; }
kv()      { printf "  ${C_CYAN}%-32s${C_RESET} %s\n" "$1" "$2"; }
ok()      { printf "  ${C_GREEN}✓${C_RESET} %s\n" "$1"; }
bad()     { printf "  ${C_RED}✗${C_RESET} %s\n" "$1"; }
note()    { printf "  ${C_DIM}%s${C_RESET}\n" "$1"; }

mask() {
  # Mask a secret-like string: keep first 4 + last 4
  local v="$1"
  local n=${#v}
  if (( n <= 8 )); then printf '****'; else printf '%s…%s' "${v:0:4}" "${v: -4}"; fi
}

# ---------- 1. Environment variables ----------
section "Environment variables"

# Known AWS-related env vars (CLI/SDK + common third-party)
ENV_VARS=(
  AWS_PROFILE
  AWS_DEFAULT_PROFILE
  AWS_REGION
  AWS_DEFAULT_REGION
  AWS_ACCESS_KEY_ID
  AWS_SECRET_ACCESS_KEY
  AWS_SESSION_TOKEN
  AWS_SECURITY_TOKEN
  AWS_CREDENTIAL_EXPIRATION
  AWS_CONFIG_FILE
  AWS_SHARED_CREDENTIALS_FILE
  AWS_ROLE_ARN
  AWS_ROLE_SESSION_NAME
  AWS_WEB_IDENTITY_TOKEN_FILE
  AWS_CA_BUNDLE
  AWS_ENDPOINT_URL
  AWS_USE_FIPS_ENDPOINT
  AWS_USE_DUALSTACK_ENDPOINT
  AWS_RETRY_MODE
  AWS_MAX_ATTEMPTS
  AWS_EC2_METADATA_DISABLED
  AWS_METADATA_SERVICE_TIMEOUT
  AWS_METADATA_SERVICE_NUM_ATTEMPTS
  AWS_DATA_PATH
  AWS_PAGER
  AWS_SDK_LOAD_CONFIG
  AWS_CLI_AUTO_PROMPT
  AWS_CLI_FILE_ENCODING
  AWS_DEFAULT_OUTPUT
  AWS_VAULT                # set by aws-vault when shelled into a session
  AWS_VAULT_PROMPT
  AWS_SESSION_EXPIRATION
)

SECRETLIKE=(AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_SECURITY_TOKEN AWS_WEB_IDENTITY_TOKEN_FILE)

any_set=0
for var in "${ENV_VARS[@]}"; do
  val="${!var-}"
  if [[ -n "${val}" ]]; then
    any_set=1
    show="$val"
    for s in "${SECRETLIKE[@]}"; do
      if [[ "$var" == "$s" ]]; then show="$(mask "$val")"; break; fi
    done
    if [[ "$var" == "AWS_ACCESS_KEY_ID" ]]; then show="$(mask "$val")"; fi
    kv "$var" "$show"
  fi
done
if (( any_set == 0 )); then
  note "no AWS_* environment variables are set"
fi

# ---------- 2. Config & credentials files ----------
section "Config & credentials files"

CONFIG_FILE="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
CREDS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"

kv "config file" "$CONFIG_FILE"
if [[ -f "$CONFIG_FILE" ]]; then
  ok "exists"
else
  note "(missing)"
fi

kv "credentials file" "$CREDS_FILE"
if [[ -f "$CREDS_FILE" ]]; then
  ok "exists"
else
  note "(missing)"
fi

# Parse profile names from both files
list_profiles_from() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  # config file uses [profile foo] except for [default]; credentials uses [foo]
  awk '
    /^\[/ {
      gsub(/[][]/,"")
      sub(/^profile /,"")
      print
    }
  ' "$file"
}

CONFIG_PROFILES=()
CREDS_PROFILES=()
if [[ -f "$CONFIG_FILE" ]]; then
  while IFS= read -r p; do CONFIG_PROFILES+=("$p"); done < <(list_profiles_from "$CONFIG_FILE")
fi
if [[ -f "$CREDS_FILE" ]]; then
  while IFS= read -r p; do CREDS_PROFILES+=("$p"); done < <(list_profiles_from "$CREDS_FILE")
fi

if (( ${#CONFIG_PROFILES[@]} > 0 )); then
  kv "profiles in config" "${CONFIG_PROFILES[*]}"
fi
if (( ${#CREDS_PROFILES[@]} > 0 )); then
  kv "profiles in credentials" "${CREDS_PROFILES[*]}"
fi

# ---------- 3. Active profile resolution ----------
section "Active profile"

ACTIVE_PROFILE="${AWS_PROFILE:-${AWS_DEFAULT_PROFILE:-default}}"
if [[ -n "${AWS_PROFILE-}" ]]; then
  kv "selected via" "AWS_PROFILE"
elif [[ -n "${AWS_DEFAULT_PROFILE-}" ]]; then
  kv "selected via" "AWS_DEFAULT_PROFILE"
else
  kv "selected via" "default (no AWS_PROFILE set)"
fi
kv "profile name" "$ACTIVE_PROFILE"

# Show region resolution
ACTIVE_REGION=""
REGION_SRC=""
if [[ -n "${AWS_REGION-}" ]]; then
  ACTIVE_REGION="$AWS_REGION"; REGION_SRC="AWS_REGION"
elif [[ -n "${AWS_DEFAULT_REGION-}" ]]; then
  ACTIVE_REGION="$AWS_DEFAULT_REGION"; REGION_SRC="AWS_DEFAULT_REGION"
fi
if [[ -z "$ACTIVE_REGION" && -f "$CONFIG_FILE" ]]; then
  # Pull region from the active profile section
  section_header="\\[(profile )?${ACTIVE_PROFILE}\\]"
  ACTIVE_REGION=$(awk -v hdr="$section_header" '
    $0 ~ "^\\[" { in_sect = ($0 ~ hdr) ? 1 : 0; next }
    in_sect && /^[[:space:]]*region[[:space:]]*=/ {
      sub(/^[[:space:]]*region[[:space:]]*=[[:space:]]*/,"")
      print; exit
    }
  ' "$CONFIG_FILE")
  if [[ -n "$ACTIVE_REGION" ]]; then REGION_SRC="config[$ACTIVE_PROFILE]"; fi
fi
if [[ -n "$ACTIVE_REGION" ]]; then
  kv "region" "$ACTIVE_REGION  ${C_DIM}(via $REGION_SRC)${C_RESET}"
else
  kv "region" "(not set)"
  warn "no region resolved — many AWS calls will fail without one"
fi

# Profile referenced but not defined?
profile_defined=0
for p in "${CONFIG_PROFILES[@]}" "${CREDS_PROFILES[@]}"; do
  if [[ "$p" == "$ACTIVE_PROFILE" ]]; then profile_defined=1; break; fi
done
if (( profile_defined == 0 )) && [[ "$ACTIVE_PROFILE" != "default" ]]; then
  err "Profile '$ACTIVE_PROFILE' is selected but not defined in $CONFIG_FILE or $CREDS_FILE"
fi

# Detect SSO config for active profile
if [[ -f "$CONFIG_FILE" ]] && (( profile_defined == 1 )); then
  hdr="\\[(profile )?${ACTIVE_PROFILE}\\]"
  sso_session=$(awk -v hdr="$hdr" '
    $0 ~ "^\\[" { in_sect = ($0 ~ hdr) ? 1 : 0; next }
    in_sect && /^[[:space:]]*sso_(session|start_url|account_id|role_name)[[:space:]]*=/ { print; }
  ' "$CONFIG_FILE")
  if [[ -n "$sso_session" ]]; then
    kv "auth type" "SSO"
    note "$(printf '%s' "$sso_session" | sed 's/^/    /')"
  fi
  source_profile=$(awk -v hdr="$hdr" '
    $0 ~ "^\\[" { in_sect = ($0 ~ hdr) ? 1 : 0; next }
    in_sect && /^[[:space:]]*source_profile[[:space:]]*=/ {
      sub(/^[[:space:]]*source_profile[[:space:]]*=[[:space:]]*/,""); print; exit
    }
  ' "$CONFIG_FILE")
  role_arn=$(awk -v hdr="$hdr" '
    $0 ~ "^\\[" { in_sect = ($0 ~ hdr) ? 1 : 0; next }
    in_sect && /^[[:space:]]*role_arn[[:space:]]*=/ {
      sub(/^[[:space:]]*role_arn[[:space:]]*=[[:space:]]*/,""); print; exit
    }
  ' "$CONFIG_FILE")
  if [[ -n "$role_arn" ]]; then
    kv "role_arn" "$role_arn"
    [[ -n "$source_profile" ]] && kv "source_profile" "$source_profile"
  fi
fi

# ---------- 4. Conflict detection ----------
section "Conflict & sanity checks"

# Env credentials override profile entirely — point this out.
if [[ -n "${AWS_ACCESS_KEY_ID-}" || -n "${AWS_SECRET_ACCESS_KEY-}" || -n "${AWS_SESSION_TOKEN-}" ]]; then
  if [[ -n "${AWS_PROFILE-}" || -n "${AWS_DEFAULT_PROFILE-}" ]]; then
    warn "Both env credentials AND a profile are set. Env creds win — the profile is effectively ignored."
  fi
  if [[ -f "$CREDS_FILE" ]] || [[ -f "$CONFIG_FILE" ]]; then
    info "Env credentials are set; ~/.aws/credentials and any profile creds are ignored."
  fi
fi

# Half-set credential triplets
if [[ -n "${AWS_ACCESS_KEY_ID-}" && -z "${AWS_SECRET_ACCESS_KEY-}" ]]; then
  err "AWS_ACCESS_KEY_ID is set but AWS_SECRET_ACCESS_KEY is not — auth will fail."
fi
if [[ -z "${AWS_ACCESS_KEY_ID-}" && -n "${AWS_SECRET_ACCESS_KEY-}" ]]; then
  err "AWS_SECRET_ACCESS_KEY is set but AWS_ACCESS_KEY_ID is not — auth will fail."
fi
if [[ -n "${AWS_SESSION_TOKEN-}" && -z "${AWS_ACCESS_KEY_ID-}" ]]; then
  err "AWS_SESSION_TOKEN is set without AWS_ACCESS_KEY_ID — temp credentials are incomplete."
fi

# Both AWS_PROFILE and AWS_DEFAULT_PROFILE set
if [[ -n "${AWS_PROFILE-}" && -n "${AWS_DEFAULT_PROFILE-}" && "${AWS_PROFILE}" != "${AWS_DEFAULT_PROFILE}" ]]; then
  warn "AWS_PROFILE ('${AWS_PROFILE}') and AWS_DEFAULT_PROFILE ('${AWS_DEFAULT_PROFILE}') disagree. AWS_PROFILE wins."
fi

# Both AWS_REGION and AWS_DEFAULT_REGION set, disagreeing
if [[ -n "${AWS_REGION-}" && -n "${AWS_DEFAULT_REGION-}" && "${AWS_REGION}" != "${AWS_DEFAULT_REGION}" ]]; then
  warn "AWS_REGION ('${AWS_REGION}') and AWS_DEFAULT_REGION ('${AWS_DEFAULT_REGION}') disagree. AWS_REGION wins for the CLI."
fi

# Credential expiration in the past?
if [[ -n "${AWS_CREDENTIAL_EXPIRATION-}" ]]; then
  # Expect ISO-8601, e.g. 2024-01-01T12:34:56Z
  if exp_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "${AWS_CREDENTIAL_EXPIRATION%%.*}" "+%s" 2>/dev/null); then
    now_epoch=$(date "+%s")
    if (( exp_epoch < now_epoch )); then
      err "AWS_CREDENTIAL_EXPIRATION is in the past ($AWS_CREDENTIAL_EXPIRATION) — credentials are expired."
    else
      remaining=$(( (exp_epoch - now_epoch) / 60 ))
      info "AWS credentials expire in ~${remaining} minute(s) (at $AWS_CREDENTIAL_EXPIRATION)."
    fi
  fi
fi

# aws-vault session
if [[ -n "${AWS_VAULT-}" ]]; then
  info "AWS_VAULT='${AWS_VAULT}' — you're inside an aws-vault session. Env creds are ephemeral."
fi

# Custom endpoint
if [[ -n "${AWS_ENDPOINT_URL-}" ]]; then
  warn "AWS_ENDPOINT_URL='${AWS_ENDPOINT_URL}' — all calls are redirected (often LocalStack/MinIO). Real AWS won't be hit."
fi

# Metadata service disabled
if [[ -n "${AWS_EC2_METADATA_DISABLED-}" && "${AWS_EC2_METADATA_DISABLED}" == "true" ]]; then
  info "EC2 instance metadata service is disabled (AWS_EC2_METADATA_DISABLED=true)."
fi

# Custom config/creds file paths
if [[ -n "${AWS_CONFIG_FILE-}" && ! -f "${AWS_CONFIG_FILE}" ]]; then
  err "AWS_CONFIG_FILE='${AWS_CONFIG_FILE}' is set but the file does not exist."
fi
if [[ -n "${AWS_SHARED_CREDENTIALS_FILE-}" && ! -f "${AWS_SHARED_CREDENTIALS_FILE}" ]]; then
  err "AWS_SHARED_CREDENTIALS_FILE='${AWS_SHARED_CREDENTIALS_FILE}' is set but the file does not exist."
fi

# Same profile in both config and credentials — usually fine but worth noting
if (( ${#CONFIG_PROFILES[@]} > 0 && ${#CREDS_PROFILES[@]} > 0 )); then
  for cp in "${CONFIG_PROFILES[@]}"; do
    for crp in "${CREDS_PROFILES[@]}"; do
      if [[ "$cp" == "$crp" && "$cp" == "$ACTIVE_PROFILE" ]]; then
        info "Active profile '$cp' is defined in BOTH $CONFIG_FILE and $CREDS_FILE. SDK merges them; credentials file wins for keys."
      fi
    done
  done
fi

# SSO cache freshness
SSO_CACHE_DIR="$HOME/.aws/sso/cache"
if [[ -d "$SSO_CACHE_DIR" ]]; then
  expired=0; valid=0
  for f in "$SSO_CACHE_DIR"/*.json; do
    [[ -f "$f" ]] || continue
    # Try to extract expiresAt without jq
    exp=$(grep -o '"expiresAt"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    if [[ -n "$exp" ]]; then
      if exp_epoch=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "${exp%%.*}" "+%s" 2>/dev/null); then
        now_epoch=$(date "+%s")
        if (( exp_epoch < now_epoch )); then expired=$((expired+1)); else valid=$((valid+1)); fi
      fi
    fi
  done
  if (( valid > 0 )); then
    info "SSO cache: $valid valid token(s), $expired expired."
  elif (( expired > 0 )); then
    warn "SSO cache has only expired tokens — run 'aws sso login' to refresh."
  fi
fi

if (( ${#WARNINGS[@]} == 0 && ${#ERRORS[@]} == 0 )); then
  ok "No conflicts detected."
fi

# ---------- 5. Identity check ----------
section "Identity check (sts get-caller-identity)"

if ! command -v aws >/dev/null 2>&1; then
  bad "AWS CLI not installed (or not on PATH). Install it to verify the active credentials work."
  note "macOS: brew install awscli"
else
  kv "aws version" "$(aws --version 2>&1 | head -1)"
  if out=$(aws sts get-caller-identity --output json 2>&1); then
    ok "Authenticated."
    printf '%s\n' "$out" | sed 's/^/    /'
  else
    bad "sts get-caller-identity failed:"
    printf '%s\n' "$out" | sed 's/^/    /'
    err "AWS rejected the current credentials. See the message above."
  fi
fi

# ---------- 6. Summary ----------
section "Summary"

if (( ${#ERRORS[@]} > 0 )); then
  printf "${C_RED}${C_BOLD}Errors:${C_RESET}\n"
  for e in "${ERRORS[@]}"; do printf "  ${C_RED}✗${C_RESET} %s\n" "$e"; done
fi
if (( ${#WARNINGS[@]} > 0 )); then
  printf "${C_YELLOW}${C_BOLD}Warnings:${C_RESET}\n"
  for w in "${WARNINGS[@]}"; do printf "  ${C_YELLOW}!${C_RESET} %s\n" "$w"; done
fi
if (( ${#INFO[@]} > 0 )); then
  printf "${C_BLUE}${C_BOLD}Notes:${C_RESET}\n"
  for i in "${INFO[@]}"; do printf "  ${C_BLUE}i${C_RESET} %s\n" "$i"; done
fi
if (( ${#ERRORS[@]} == 0 && ${#WARNINGS[@]} == 0 )); then
  printf "${C_GREEN}${C_BOLD}Looks good.${C_RESET}\n"
fi

# Exit non-zero if there are errors, so it's scriptable too.
if (( ${#ERRORS[@]} > 0 )); then exit 1; fi
exit 0
